  "extraction_rules": {
    "size_patterns": [
      "(\\d+\\s*(?:inch|in|\"|NB|mm|sq\\s*mm))",
      "(\\d+\\s*x\\s*\\d+(?:\\s*x\\s*\\d+)?\\s*(?:mm|inch|in|\")?)"
    ],
    "material_type_patterns": [
      "(stainless\\s*steel(?:\\s*316|\\s*304)?|SS316|SS304|mild\\s*steel|carbon\\s*steel|WCB|HDPE|XLPE|ALUMINIUM|AL)"
    ],
    "pressure_class_patterns": [
      "(class\\s*\\d+|CL-\\d+|\\d+#|PN\\d+|\\d+\\s*bar)",
      "(\\d+\\.\\d+\\s*kV|\\d+\\s*kV)"
    ],
    "power_capacity_patterns": [
      "(\\d+\\s*kW|\\d+\\s*HP|\\d+\\s*RPM)"
    ],
    "model_number_patterns": [
      "(6\\d{3}(?:-[2ZRS1C3]+)?|API\\s*\\d+|IS\\s*\\d+)"
    ]
  }
}
